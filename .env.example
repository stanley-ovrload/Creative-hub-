# Path to the SQLite job store, used by both the console (Next.js) and
# the worker (npm run worker). Relative paths resolve against the repo
# root. Defaults to data/jobs.db if unset.
DATABASE_PATH=data/jobs.db

# Used by the worker's classification step (Claude Opus 4.8) to resolve
# a job's brief into a pipeline type. Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
